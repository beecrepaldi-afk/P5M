+/**
+ * P5M: pacotes recebidos e perdidos desde a ultima leitura.
+ *
+ * O libchiaki ja contava -- o ChiakiPacketStats existe para a correcao de erros
+ * e para o controle de congestionamento -- e o numero nunca saia dali. Do lado
+ * do app so havia o bloco de "FEC failed" no log, que diz que houve perda mas
+ * nao quanta, e so aparece depois que a imagem ja quebrou.
+ *
+ * Devolve os dois valores empacotados num long: recebidos nos 32 bits altos,
+ * perdidos nos baixos. Um par de longs pediria um objeto de retorno e uma
+ * alocacao por leitura, e isto e lido uma vez por segundo com o painel aberto.
+ *
+ * Le sem zerar (reset = false): quem zera e o controle de congestionamento do
+ * proprio chiaki, e roubar a contagem dele estragaria a decisao que ele toma
+ * com ela.
+ */
+JNIEXPORT jlong JNICALL JNI_FCN(sessionPacketStats)(JNIEnv *env, jobject obj, jlong ptr)
+{
+	AndroidChiakiSession *session = (AndroidChiakiSession *)ptr;
+	if(!session)
+		return 0;
+	uint64_t received = 0, lost = 0;
+	chiaki_packet_stats_get(&session->session.stream_connection.packet_stats, false,
+			&received, &lost);
+	if(received > 0x7fffffffULL)
+		received = 0x7fffffffULL;
+	if(lost > 0x7fffffffULL)
+		lost = 0x7fffffffULL;
+	return (jlong)((received << 32) | lost);
+}
