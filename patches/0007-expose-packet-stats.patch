+	// P5M: dois campos que o app Android nunca preenchia.
+	//
+	// packet_loss_max e o teto da perda que o cliente *relata* ao console. Em
+	// zero -- que e o que o { 0 } deixava -- o controle de congestionamento
+	// mede a perda de verdade e a corta para zero antes de mandar. O log
+	// registrava exatamente isso: "Clamping reported packet loss: measured=2.6%
+	// reported_max=0.0%". O console recebia "esta tudo bem" enquanto os pacotes
+	// sumiam, e nunca tinha motivo para baixar o bitrate. 0.05 nao e escolha
+	// minha: e o proprio padrao do chiaki-ng no desktop, que a porta Android
+	// deixou de copiar.
+	connect_info.packet_loss_max = 0.05;
+
+	// enable_idr_on_fec_failure pede um quadro-chave quando a correcao de erros
+	// falha. Sem ele, o decodificador segue decodificando a partir de uma
+	// referencia quebrada -- e o "Missing reference frame 5975 for decoding
+	// frame 5976 -> changed to 5974" que enche o log e justamente isso: o
+	// estrago se arrasta para a frente ate o console mandar um quadro-chave por
+	// conta propria, o que no Remote Play pode demorar segundos.
+	//
+	// Aqui eu difiro do padrao do chiaki-ng, que o deixa desligado, e digo por
+	// que: o quadro-chave e grande e chega logo depois de a rede ter falhado,
+	// entao num link fraco ele pode piorar o que ja estava ruim. Num link forte
+	// -- Wi-Fi 6E com o console no cabo, que e o caso -- a perda e rara e
+	// isolada, e alguns centesimos de segundo de pico valem muito mais do que
+	// segundos de imagem rachada. O proprio libchiaki evita repetir o pedido
+	// enquanto espera o quadro que ja pediu.
+	connect_info.enable_idr_on_fec_failure = true;
+
 	const char *str_borrow = E->GetStringUTFChars(env, host_string, NULL);
