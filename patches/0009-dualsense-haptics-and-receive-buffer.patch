+// P5M: a vibracao do PS5 nao chega como vibracao.
+//
+// O diario de dev.76 nao mostrava nenhum pacote de tipo 7 (rumble) em tres
+// sessoes, e eu conclui que o console nao mandava nada. Estava errado, e o
+// proprio codigo do chiaki-ng diz por que.
+//
+// O DualSense nao tem motor de rotacao: tem dois atuadores de bobina, que sao
+// alto-falantes. O console nao manda "esquerdo 200, direito 40" -- ele manda
+// *audio*, um segundo fluxo PCM estereo de 16 bits marcado com is_haptics, na
+// mesma via do som do jogo. Por isso o grep por tipos de dado nunca acharia:
+// haptica nao e um tipo de dado, e uma trilha de audio.
+//
+// E o console so manda esse fluxo se o cliente se apresentar como DualSense.
+// A porta Android do chiaki nunca preencheu enable_dualsense: o ConnectInfo
+// saia zerado, o cliente se anunciava como DualShock 4, e um DualShock 4 nao
+// recebe haptica. O que veio depois disso e coerente com o pedido: nada.
+//
+// Aqui fechamos os dois lados. enable_dualsense faz o console mandar, e este
+// callback transforma o audio em intensidade. E a mesma conversao que o
+// chiaki-ng usa no desktop para controle por Bluetooth ("rumble emulado"),
+// porque Bluetooth nao carrega audio ate o controle -- so o comando antigo de
+// vibrar. Media do valor absoluto das amostras, piso para nao vibrar por
+// ruido, media de tres pacotes para nao trepidar a cada 10 ms.
+#define P5M_HAPTICS_MIN_STRENGTH 100
+#define P5M_HAPTICS_PACKETS_PER_RUMBLE 3
+#define P5M_HAPTICS_GAIN 2
+#define P5M_HAPTICS_FLOOR 40
+
+static void android_chiaki_haptics_frame(uint8_t *buf, size_t buf_size, void *user)
+{
+	AndroidChiakiSession *session = user;
+	const size_t sample_size = 2 * sizeof(int16_t); // estereo
+	size_t samples = buf_size / sample_size;
+	if(!samples)
+		return;
+
+	if(!session->haptics_logged)
+	{
+		session->haptics_logged = true;
+		CHIAKI_LOGW(session->log, "P5M: first haptics frame from the console (%zu bytes, %zu samples)",
+				buf_size, samples);
+	}
+
+	uint32_t sum_l = 0, sum_r = 0;
+	for(size_t i = 0; i < samples; i++)
+	{
+		int16_t l = 0, r = 0;
+		memcpy(&l, buf + i * sample_size, sizeof(int16_t));
+		memcpy(&r, buf + i * sample_size + sizeof(int16_t), sizeof(int16_t));
+		sum_l += (uint32_t)(l < 0 ? -(int32_t)l : (int32_t)l) * 2;
+		sum_r += (uint32_t)(r < 0 ? -(int32_t)r : (int32_t)r) * 2;
+	}
+
+	uint32_t left = sum_l / samples;
+	uint32_t right = sum_r / samples;
+	if(left < P5M_HAPTICS_MIN_STRENGTH)
+		left = 0;
+	if(right < P5M_HAPTICS_MIN_STRENGTH)
+		right = 0;
+
+	session->haptics_accum_l += left;
+	session->haptics_accum_r += right;
+	if(++session->haptics_accum_count < P5M_HAPTICS_PACKETS_PER_RUMBLE)
+		return;
+
+	left = session->haptics_accum_l / P5M_HAPTICS_PACKETS_PER_RUMBLE;
+	right = session->haptics_accum_r / P5M_HAPTICS_PACKETS_PER_RUMBLE;
+	session->haptics_accum_l = 0;
+	session->haptics_accum_r = 0;
+	session->haptics_accum_count = 0;
+
+	// Do audio de 16 bits para a intensidade de 8 bits do vibrador.
+	//
+	// O >> 8 sozinho seria a conversao fiel -- e o equivalente ao "Normal" do
+	// chiaki-ng, que entrega 16 bits ao SDL. Aqui ele nao serve: o destino nao
+	// e a bobina do DualSense, e o motor comum acionado por relatorio HID do
+	// Bluetooth, que so comeca a ser sentido bem acima do zero. Um efeito leve
+	// (media de umas poucas milhares de amostras) viraria 3 em 255 e nao seria
+	// sentido -- indistinguivel de nao ter chegado nada, que e exatamente a
+	// duvida que este caminho existe para responder.
+	//
+	// Entao: ganho de 2 (o "Strong" do chiaki-ng) e piso de 40 para o que
+	// passou do limiar. O piso nao inventa vibracao onde nao ha; ele so
+	// garante que o que o jogo mandou seja perceptivel. Se em jogo tudo sair
+	// forte demais, sao estes dois numeros.
+	uint32_t scaled_l = left * P5M_HAPTICS_GAIN;
+	uint32_t scaled_r = right * P5M_HAPTICS_GAIN;
+	int rumble_l = (int)((scaled_l > 0xffff ? 0xffff : scaled_l) >> 8);
+	int rumble_r = (int)((scaled_r > 0xffff ? 0xffff : scaled_r) >> 8);
+	if(left > 0 && rumble_l < P5M_HAPTICS_FLOOR)
+		rumble_l = P5M_HAPTICS_FLOOR;
+	if(right > 0 && rumble_r < P5M_HAPTICS_FLOOR)
+		rumble_r = P5M_HAPTICS_FLOOR;
+
+	// Deduplicacao antes do JNI, e nao depois. Do outro lado Rumble.set() ja
+	// descarta valor repetido, mas para descobrir isso ele precisaria ter
+	// atravessado a fronteira -- e atravessar significa anexar e desanexar a
+	// thread do takion, a mesma que entrega video, cem vezes por segundo.
+	if(rumble_l == session->haptics_last_l && rumble_r == session->haptics_last_r)
+		return;
+	session->haptics_last_l = rumble_l;
+	session->haptics_last_r = rumble_r;
+
+	JNIEnv *env = attach_thread_jni();
+	if(!env)
+		return;
+	E->CallVoidMethod(env, session->java_session,
+					  session->java_session_event_rumble_meth,
+					  (jint)rumble_l, (jint)rumble_r);
+	(*global_vm)->DetachCurrentThread(global_vm);
+}
