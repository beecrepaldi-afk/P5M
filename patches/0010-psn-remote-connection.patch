+// Recolhe as linhas que a libchiaki registra durante uma chamada.
+//
+// Sem isto o motivo de uma falha existe, mas em lugar nenhum util: o log da
+// libchiaki no Android vai para o logcat, e o diario do P5M e outro arquivo.
+// Quem esta longe de casa, sem PC, nao le logcat -- entao a mensagem que
+// explica a falha morre a dois metros de quem precisa dela.
+//
+// Com um log proprio passado so para a chamada, a linha ("... failed with HTTP
+// code 401", por exemplo) volta como texto e sobe ate a tela.
+#define P5M_CAPTURA_MAX 512
+
+// Definida em log.c e nao declarada em log.h. E o callback que escreve no
+// logcat; queremos capturar *e* continuar escrevendo lá.
+void log_cb_android(ChiakiLogLevel level, const char *msg, void *user);
+
+typedef struct p5m_captura_t
+{
+	char texto[P5M_CAPTURA_MAX];
+	size_t usado;
+} P5mCaptura;
+
+static void p5m_captura_cb(ChiakiLogLevel level, const char *msg, void *user)
+{
+	P5mCaptura *c = user;
+	// Repassa para o logcat tambem: quem tiver PC continua vendo tudo.
+	log_cb_android(level, msg, NULL);
+	if(level != CHIAKI_LOG_ERROR && level != CHIAKI_LOG_WARNING)
+		return;
+	if(c->usado + 2 >= sizeof(c->texto))
+		return;
+	// A ultima linha de erro e a que interessa; as anteriores ficam se couberem.
+	int escrito = snprintf(c->texto + c->usado, sizeof(c->texto) - c->usado,
+			"%s%s", c->usado ? " | " : "", msg);
+	if(escrito > 0)
+		c->usado += (size_t)escrito;
+	if(c->usado >= sizeof(c->texto))
+		c->usado = sizeof(c->texto) - 1;
+}
+
+// Dois caracteres hexadecimais viram um byte, ou a funcao devolve falso.
+// Existe aqui em vez de usar o parse_hex da libchiaki porque aquele mora em
+// lib/src/utils.h, que e cabecalho privado e nao esta no caminho de include
+// deste arquivo.
+static bool p5m_hex_byte(const char *duo, uint8_t *out)
+{
+	uint8_t valor = 0;
+	for(int i = 0; i < 2; i++)
+	{
+		char c = duo[i];
+		uint8_t digito;
+		if(c >= '0' && c <= '9')
+			digito = (uint8_t)(c - '0');
+		else if(c >= 'a' && c <= 'f')
+			digito = (uint8_t)(c - 'a' + 10);
+		else if(c >= 'A' && c <= 'F')
+			digito = (uint8_t)(c - 'A' + 10);
+		else
+			return false;
+		valor = (uint8_t)((valor << 4) | digito);
+	}
+	*out = valor;
+	return true;
+}
