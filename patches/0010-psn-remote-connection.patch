+// P5M: as tres funcoes da conexao remota via PSN.
+//
+// Nenhuma delas inventa protocolo: a libchiaki ja traz tudo pronto e este e o
+// mesmo roteiro que o chiaki-ng roda no desktop (gui/src/streamsession.cpp,
+// ConnectPsnConnection). O que faltava era a ponte -- a porta Android nunca
+// expos nada disso ao Kotlin.
+
+JNIEXPORT jstring JNICALL JNI_FCN(psnDuid)(JNIEnv *env, jobject obj)
+{
+	char duid[CHIAKI_DUID_STR_SIZE];
+	size_t duid_size = sizeof(duid);
+	ChiakiErrorCode err = chiaki_holepunch_generate_client_device_uid(duid, &duid_size);
+	if(err != CHIAKI_ERR_SUCCESS)
+	{
+		CHIAKI_LOGE(&global_log, "P5M: failed to generate the client duid");
+		return NULL;
+	}
+	return E->NewStringUTF(env, duid);
+}
+
+JNIEXPORT jobjectArray JNICALL JNI_FCN(psnListDevices)(JNIEnv *env, jobject obj, jstring token_string, jboolean ps5)
+{
+	// O primeiro elemento e sempre o estado: "ok" ou "erro\t<motivo>". Os
+	// consoles vem depois.
+	//
+	// Antes esta funcao devolvia NULL em qualquer falha, e do lado de la NULL e
+	// lista vazia viravam a mesma frase na tela -- "no console showed up".
+	// Sao tres coisas diferentes: token recusado, servidor fora, e conta que
+	// realmente nao tem console visivel. So a terceira e sobre o console; as
+	// outras duas sao sobre nos. Juntar as tres numa mensagem so foi o que fez
+	// a primeira falha de verdade nao dizer nada.
+	jclass string_class = E->FindClass(env, "java/lang/String");
+
+	const char *token = token_string ? E->GetStringUTFChars(env, token_string, NULL) : NULL;
+	if(!token || !token[0])
+	{
+		if(token)
+			E->ReleaseStringUTFChars(env, token_string, token);
+		jobjectArray so_erro = E->NewObjectArray(env, 1, string_class, NULL);
+		jstring linha = E->NewStringUTF(env, "error\tno access token");
+		E->SetObjectArrayElement(env, so_erro, 0, linha);
+		E->DeleteLocalRef(env, linha);
+		return so_erro;
+	}
+
+	// Log proprio so para esta chamada, para o motivo da falha voltar como
+	// texto em vez de sumir no logcat.
+	P5mCaptura captura = { .texto = { 0 }, .usado = 0 };
+	ChiakiLog log_capturado;
+	chiaki_log_init(&log_capturado, CHIAKI_LOG_ALL & ~CHIAKI_LOG_VERBOSE,
+			p5m_captura_cb, &captura);
+
+	ChiakiHolepunchDeviceInfo *devices = NULL;
+	size_t count = 0;
+	ChiakiErrorCode err = chiaki_holepunch_list_devices(token,
+			ps5 ? CHIAKI_HOLEPUNCH_CONSOLE_TYPE_PS5 : CHIAKI_HOLEPUNCH_CONSOLE_TYPE_PS4,
+			&devices, &count, &log_capturado);
+	E->ReleaseStringUTFChars(env, token_string, token);
+	if(err != CHIAKI_ERR_SUCCESS)
+	{
+		CHIAKI_LOGE(&global_log, "P5M: PSN refused the console list (%s)", chiaki_error_string(err));
+		char linha_erro[P5M_CAPTURA_MAX + 128];
+		snprintf(linha_erro, sizeof(linha_erro), "error\t%s%s%s",
+				chiaki_error_string(err),
+				captura.usado ? " — " : "",
+				captura.usado ? captura.texto : "");
+		jobjectArray so_erro = E->NewObjectArray(env, 1, string_class, NULL);
+		jstring linha = E->NewStringUTF(env, linha_erro);
+		E->SetObjectArrayElement(env, so_erro, 0, linha);
+		E->DeleteLocalRef(env, linha);
+		return so_erro;
+	}
+
+	// Registrado em WARNING, e nao em INFO, pelo mesmo motivo das marcacoes de
+	// socket: o log_cb do Android mapeia WARNING para ANDROID_LOG_ERROR, e e
+	// isso que o diario do P5M captura. Em INFO estas linhas existiriam so
+	// no buffer circular do logcat -- e sem PC, longe de casa, uma linha que
+	// nao chega ao diario nao chega a lugar nenhum.
+	CHIAKI_LOGW(&global_log, "P5M: a PSN respondeu com %zu console(s) na conta", count);
+
+	jobjectArray out = E->NewObjectArray(env, (jsize)count + 1, string_class, NULL);
+	jstring estado = E->NewStringUTF(env, "ok");
+	E->SetObjectArrayElement(env, out, 0, estado);
+	E->DeleteLocalRef(env, estado);
+
+	for(size_t i = 0; i < count; i++)
+	{
+		char linha[32 * 2 + 1 + sizeof(devices[i].device_name) + 8];
+		char hex[sizeof(devices[i].device_uid) * 2 + 1];
+		for(size_t b = 0; b < sizeof(devices[i].device_uid); b++)
+			snprintf(hex + b * 2, 3, "%02x", devices[i].device_uid[b]);
+		// device_name pode vir sem terminador se ocupar os 32 bytes.
+		char nome[sizeof(devices[i].device_name) + 1];
+		memcpy(nome, devices[i].device_name, sizeof(devices[i].device_name));
+		nome[sizeof(devices[i].device_name)] = '\0';
+		snprintf(linha, sizeof(linha), "%s\t%s\t%d", hex, nome, devices[i].remoteplay_enabled ? 1 : 0);
+		CHIAKI_LOGW(&global_log, "P5M: console %zu on the PSN account (remote play %s)",
+				i + 1, devices[i].remoteplay_enabled ? "on" : "off");
+		jstring linha_java = E->NewStringUTF(env, linha);
+		E->SetObjectArrayElement(env, out, (jsize)i + 1, linha_java);
+		E->DeleteLocalRef(env, linha_java);
+	}
+	chiaki_holepunch_free_device_list(&devices);
+	return out;
+}
