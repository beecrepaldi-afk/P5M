+JNIEXPORT jint JNICALL JNI_FCN(sessionConnectPsn)(JNIEnv *env, jobject obj, jlong ptr, jstring duid_string, jboolean ps5)
+{
+	AndroidChiakiSession *session = (AndroidChiakiSession *)ptr;
+	if(!session || !session->holepunch)
+		return (jint)CHIAKI_ERR_INVALID_DATA;
+
+	const char *duid = E->GetStringUTFChars(env, duid_string, NULL);
+	size_t duid_len = strlen(duid);
+	// device_uid tem 32 bytes, entao 64 caracteres em hexadecimal. O buffer
+	// segue esse tamanho e nada maior e aceito.
+	uint8_t duid_bytes[32];
+	const size_t duid_bytes_len = duid_len / 2;
+	bool duid_ok = duid_len == sizeof(duid_bytes) * 2;
+	memset(duid_bytes, 0, sizeof(duid_bytes));
+	for(size_t i = 0; duid_ok && i < duid_bytes_len; i++)
+		duid_ok = p5m_hex_byte(duid + i * 2, duid_bytes + i);
+	E->ReleaseStringUTFChars(env, duid_string, duid);
+	if(!duid_ok)
+	{
+		CHIAKI_LOGE(session->log, "P5M: the console duid is not %zu hex characters",
+				sizeof(duid_bytes) * 2);
+		return (jint)CHIAKI_ERR_INVALID_DATA;
+	}
+
+	ChiakiErrorCode err;
+
+	ChiakiHolepunchConsoleType tipo = ps5
+			? CHIAKI_HOLEPUNCH_CONSOLE_TYPE_PS5
+			: CHIAKI_HOLEPUNCH_CONSOLE_TYPE_PS4;
+
+	// A ordem destes cinco passos e obrigatoria e esta documentada no topo de
+	// lib/include/chiaki/remote/holepunch.h. Cada um registra o proprio sucesso
+	// porque, quando a coisa falha longe de casa, saber ate onde chegou e a
+	// diferenca entre "PSN did not answer" e "the console did not accept".
+	err = chiaki_holepunch_upnp_discover(session->holepunch);
+	if(err != CHIAKI_ERR_SUCCESS)
+	{
+		// Nao e fatal: UPnP so ajuda quando o roteador daqui coopera.
+		CHIAKI_LOGW(session->log, "P5M: UPnP unavailable on this network; carrying on without it");
+	}
+	err = chiaki_holepunch_session_create(session->holepunch);
+	if(err != CHIAKI_ERR_SUCCESS)
+	{
+		CHIAKI_LOGE(session->log, "P5M: PSN refused to create the remote session (%s)", chiaki_error_string(err));
+		return (jint)err;
+	}
+	CHIAKI_LOGW(session->log, "P5M: remote session created on PSN");
+
+	err = holepunch_session_create_offer(session->holepunch);
+	if(err != CHIAKI_ERR_SUCCESS)
+	{
+		CHIAKI_LOGE(session->log, "P5M: failed to build the control offer (%s)", chiaki_error_string(err));
+		return (jint)err;
+	}
+	err = chiaki_holepunch_session_start(session->holepunch, duid_bytes, tipo);
+	if(err != CHIAKI_ERR_SUCCESS)
+	{
+		CHIAKI_LOGE(session->log, "P5M: the console did not answer PSN's call (%s)", chiaki_error_string(err));
+		return (jint)err;
+	}
+	CHIAKI_LOGW(session->log, "P5M: console acordado pela PSN, furando o NAT");
+
+	err = chiaki_holepunch_session_punch_hole(session->holepunch, CHIAKI_HOLEPUNCH_PORT_TYPE_CTRL);
+	if(err != CHIAKI_ERR_SUCCESS)
+	{
+		CHIAKI_LOGE(session->log, "P5M: could not punch through NAT for the control path (%s)", chiaki_error_string(err));
+		return (jint)err;
+	}
+	CHIAKI_LOGW(session->log, "P5M: control path open; the rest is a normal session");
+	return (jint)CHIAKI_ERR_SUCCESS;
+}
+
+JNIEXPORT void JNICALL JNI_FCN(sessionCancelPsn)(JNIEnv *env, jobject obj, jlong ptr)
+{
+	AndroidChiakiSession *session = (AndroidChiakiSession *)ptr;
+	if(!session || !session->holepunch)
+		return;
+	chiaki_holepunch_main_thread_cancel(session->holepunch, true);
+}
