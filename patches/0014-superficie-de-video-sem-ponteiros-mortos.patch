+	// decoder->codec ainda diferente de NULL -- porque quem o zera vem depois
+	// do delete -- e chamava AMediaCodec_dequeueInputBuffer sobre um codec ja
+	// destruido. O processo morria com
+	//
+	//     incStrong() called on 0x... too many times, strong refs = 0
+	//
+	// vindo de MediaCodec::dequeueInputBuffer, com a pilha inteira dentro do
+	// chiaki_video_receiver_av_packet. Foi assim que a sessao imersiva remota
+	// caiu ao ser encerrada, depois de sete minutos rodando.
+	//
+	// E o ramo de erro nem esperava a thread de saida: ela continuava girando
+	// sobre decoder->codec enquanto o delete acontecia. Agora os dois ramos
+	// esperam, o que e seguro porque o AMediaCodec_stop faz o dequeue devolver
+	// erro e a thread sai pelo shutdown_output.
 	chiaki_mutex_lock(&decoder->codec_mutex);
