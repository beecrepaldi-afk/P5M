-	connect_info.enable_dualsense = true;
+	// P5M: como o cliente se apresenta ao console decide o que o console
+	// manda de volta.
+	//
+	// Anunciado como DualSense, o console abre a trilha de haptica crua e os
+	// gatilhos adaptativos. Anunciado como DualShock 4, ele nao abre nenhuma
+	// das duas -- e em troca faz ELE MESMO a reducao da haptica do jogo para
+	// dois motores, e manda o resultado como pacote de tipo 7.
+	//
+	// Nenhuma das duas e melhor em abstrato. No Quest a haptica crua nao tem
+	// como chegar ao controle (o Android nao abre relatorio HID de saida a
+	// aplicativo nenhum), entao o que sobra e adivinhar a intensidade pela
+	// envoltoria; a reducao do console e feita por quem escreveu o jogo. Quem
+	// escolhe e a preferencia, e o padrao esta em DualShock 4 por isso.
+	connect_info.enable_dualsense = E->GetBooleanField(env, connect_info_obj,
+			E->GetFieldID(env, connect_info_class, "dualsense", "Z")) == JNI_TRUE;
+	CHIAKI_LOGI(log, "P5M: anunciando o controle como %s",
+			connect_info.enable_dualsense ? "DualSense (raw haptics)"
+					: "DualShock 4 (rumble reduced by the console)");
 
