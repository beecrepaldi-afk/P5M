@@ -393,12 +393,24 @@
 	// enquanto espera o quadro que ja pediu.
 	connect_info.enable_idr_on_fec_failure = true;
 
-	// P5M: apresentar-se como DualSense. Sem isto o console manda o
-	// CONTROLLERCONNECTION com tipo DUALSHOCK4 e nunca abre a trilha de
-	// haptica -- era essa a razao de o diario nao mostrar vibracao nenhuma.
