+/**
+ * Fecha a conta de um quadro que acabou de sair do codec.
+ *
+ * Duas medidas por quadro, e elas respondem perguntas diferentes:
+ *
+ * - **Decodificacao**: da entrega ao codec ate a saida. E o pedaco do caminho
+ *   que ninguem media, entre as estatisticas de rede e a latencia do
+ *   compositor.
+ * - **Entrega**: o intervalo entre um quadro e o anterior. A media disso e
+ *   quase sempre 16,7 ms e nao diz nada; o que se sente e a distribuicao. Um
+ *   quadro que chega a 33 ms depois do anterior e uma repeticao visivel, e mil
+ *   deles com media perfeita continuam tremendo.
+ *
+ * O resumo sai uma vez a cada dez segundos, do lado da thread de saida, ja
+ * fora do mutex -- escrever no log com um mutex de caminho critico na mao seria
+ * trocar uma medicao por um engasgo.
+ */
+static void p5m_stats_sample(AndroidChiakiVideoDecoder *decoder, uint64_t pts, bool rendered)
+{
+	const uint64_t now = p5m_now_ns();
+	char linha[320];
+	bool tem_resumo = false;
+
+	chiaki_mutex_lock(&decoder->stats_mutex);
+
+	if(rendered)
+	{
+		decoder->frames_rendered++;
+		if(decoder->last_delivery_ns)
+		{
+			const uint64_t gap_full_us = (now - decoder->last_delivery_ns) / 1000;
+			if(gap_full_us > P5M_GAP_ABSENT_US)
+			{
+				// O quadro continua contando; so o intervalo e que nao entra na
+				// distribuicao.
+				decoder->source_pauses++;
+				decoder->last_delivery_ns = now;
+				goto fim_da_entrega;
+			}
+			const uint32_t gap_us = (uint32_t)gap_full_us;
+			decoder->gap_sum_us += gap_us;
+			decoder->gap_n++;
+			if(gap_us < decoder->gap_min_us)
+				decoder->gap_min_us = gap_us;
+			if(gap_us > decoder->gap_max_us)
+				decoder->gap_max_us = gap_us;
+			if(gap_us < P5M_GAP_EARLY_US)
+				decoder->gap_bucket[0]++;
+			else if(gap_us <= P5M_GAP_ONTIME_US)
+				decoder->gap_bucket[1]++;
+			else if(gap_us <= P5M_GAP_LATE_US)
+				decoder->gap_bucket[2]++;
+			else
+				decoder->gap_bucket[3]++;
+		}
+		decoder->last_delivery_ns = now;
+	}
+	else
+		decoder->frames_gated++;
+
+fim_da_entrega:;
+
+	// O PTS anda de um em um, entao o resto da divisao endereca o carimbo. Um
+	// slot que ja nao guarda este PTS significa que o anel deu a volta inteira
+	// enquanto o quadro estava dentro do codec -- e isso e informacao, nao
+	// ruido: aparece no resumo como "sem par".
+	const size_t slot = (size_t)(pts % P5M_STAMP_RING);
+	if(decoder->stamp_pts[slot] == pts)
+	{
+		const uint32_t dec_us = (uint32_t)((now - decoder->stamp_ns[slot]) / 1000);
+		decoder->stamp_pts[slot] = UINT64_MAX;
+		decoder->decode_sum_us += dec_us;
+		decoder->decode_n++;
+		if(dec_us < decoder->decode_min_us)
+			decoder->decode_min_us = dec_us;
+		if(dec_us > decoder->decode_max_us)
+			decoder->decode_max_us = dec_us;
+	}
+	else
+		decoder->decode_unknown++;
+
+	if(now - decoder->window_start_ns >= P5M_WINDOW_NS && decoder->frames_rendered > 0)
+	{
+		const double gap_med = decoder->gap_n
+				? (double)decoder->gap_sum_us / decoder->gap_n / 1000.0 : 0.0;
+		const double dec_med = decoder->decode_n
+				? (double)decoder->decode_sum_us / decoder->decode_n / 1000.0 : 0.0;
+		snprintf(linha, sizeof(linha),
+				"Video 10s: %u frames | delivery %.1f/%.1f/%.1f ms (min/avg/max) | "
+				"pacing %u early, %u on time, %u one late, %u two or more | "
+				"decode %.1f/%.1f/%.1f ms | %u unpaired, %u with the gate shut"
+				"%s",
+				decoder->frames_rendered,
+				decoder->gap_n ? decoder->gap_min_us / 1000.0 : 0.0,
+				gap_med,
+				decoder->gap_max_us / 1000.0,
+				decoder->gap_bucket[0], decoder->gap_bucket[1],
+				decoder->gap_bucket[2], decoder->gap_bucket[3],
+				decoder->decode_n ? decoder->decode_min_us / 1000.0 : 0.0,
+				dec_med,
+				decoder->decode_max_us / 1000.0,
+				decoder->decode_unknown, decoder->frames_gated,
+				decoder->source_pauses ? ", houve pausa da fonte" : "");
+		tem_resumo = true;
+		p5m_stats_reset(decoder, now);
+	}
+
+	chiaki_mutex_unlock(&decoder->stats_mutex);
+
+	// Tag P5MVR, e nao a do chiaki: o diario em arquivo captura P5MVR:I e
+	// Chiaki:E, e uma linha informativa com a tag do submodulo nao chegaria la.
+	if(tem_resumo)
+		__android_log_print(ANDROID_LOG_INFO, "P5MVR", "%s", linha);
+}
