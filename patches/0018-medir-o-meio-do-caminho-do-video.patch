 #define INPUT_BUFFER_TIMEOUT_MS 10
 
+// P5M: janela do resumo de desempenho.
+//
+// Dez segundos e um meio-termo deliberado: curto o bastante para que uma
+// travada de rede apareca isolada numa janela em vez de diluida na media da
+// sessao inteira, e longo o bastante para o diario nao virar uma linha por
+// segundo -- que era o defeito do log antigo, e o que fez o teto de tamanho
+// existir.
+#define P5M_WINDOW_NS (10ULL * 1000000000ULL)
+// Faixas do intervalo entre entregas, em microssegundos, em torno dos 16667 us
+// de uma fonte de 60 fps. Nao dependem da taxa do painel de proposito: o que
+// se quer saber e se o console entregou no ritmo dele, e essa pergunta e a
+// mesma a 72, 90 ou 120 Hz.
+#define P5M_GAP_EARLY_US 12500
+#define P5M_GAP_ONTIME_US 20800
+#define P5M_GAP_LATE_US 29200
+// Meio segundo sem quadro nao e uma entrega atrasada: e a fonte parada -- uma
+// reconexao, uma pausa, o console dormindo. Contar isso como intervalo faz a
+// media mentir e o maximo virar anedota, e foi o que aconteceu na primeira
+// medicao pela rede do projeto irmao: uma janela saiu com 38 segundos de
+// maximo, que era o remetente desligado. Trinta quadros de folga; nenhuma rede
+// plausivel segura tanto e volta.
+#define P5M_GAP_ABSENT_US 500000
+
+static uint64_t p5m_now_ns(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+}
+
+// Zera a janela. Chamado com o stats_mutex na mao.
+static void p5m_stats_reset(AndroidChiakiVideoDecoder *decoder, uint64_t now)
+{
+	decoder->window_start_ns = now;
+	decoder->decode_sum_us = 0;
+	decoder->gap_sum_us = 0;
+	decoder->decode_n = 0;
+	decoder->decode_min_us = UINT32_MAX;
+	decoder->decode_max_us = 0;
+	decoder->gap_n = 0;
+	decoder->gap_min_us = UINT32_MAX;
+	decoder->gap_max_us = 0;
+	for(int i = 0; i < 4; i++)
+		decoder->gap_bucket[i] = 0;
+	decoder->frames_rendered = 0;
+	decoder->frames_gated = 0;
+	decoder->decode_unknown = 0;
+	decoder->source_pauses = 0;
+}
