+/**
+ * P5M: entrega ao Java a haptica crua acumulada, ja em 8 bits com sinal.
+ *
+ * Devolve quantos bytes coube em `out`, que pode ser menos do que cabe --
+ * inclusive zero, quando o jogo esta em silencio. Silencio nao e falha: quem
+ * chama e que decide se manda quadro mudo ou nao manda nada.
+ *
+ * Quando o atraso passa do teto, o leitor pula para a frente em vez de
+ * entregar o passado. Isso e seguro aqui e nao seria do outro lado: o indice de
+ * leitura tem um dono so, e e esta funcao.
+ */
+JNIEXPORT jint JNICALL JNI_FCN(sessionHapticsRead)(JNIEnv *env, jobject obj, jlong ptr, jbyteArray out)
+{
+	AndroidChiakiSession *session = (AndroidChiakiSession *)ptr;
+	if(!session || !out)
+		return 0;
+
+	jsize cabe = E->GetArrayLength(env, out);
+	if(cabe <= 0)
+		return 0;
+
+	size_t w = atomic_load_explicit(&session->haptics_ring_w, memory_order_acquire);
+	size_t r = atomic_load_explicit(&session->haptics_ring_r, memory_order_relaxed);
+	size_t tem = w - r;
+
+	if(tem > P5M_HAPTICS_MAX_LAG)
+	{
+		r = w - P5M_HAPTICS_MAX_LAG;
+		tem = P5M_HAPTICS_MAX_LAG;
+		if(atomic_fetch_add_explicit(&session->haptics_skipped, 1, memory_order_relaxed) == 0)
+			CHIAKI_LOGW(session->log, "P5M: haptics running late, skipping ahead");
+	}
+
+	size_t n = tem < (size_t)cabe ? tem : (size_t)cabe;
+	if(!n)
+	{
+		atomic_store_explicit(&session->haptics_ring_r, r, memory_order_release);
+		return 0;
+	}
+
+	// Duas copias no maximo, porque o trecho pedido pode dobrar a esquina do
+	// anel. Sair com uma so por padrao seria otimizar o caso raro.
+	size_t inicio = r % P5M_HAPTICS_RING_BYTES;
+	size_t primeira = P5M_HAPTICS_RING_BYTES - inicio;
+	if(primeira > n)
+		primeira = n;
+	E->SetByteArrayRegion(env, out, 0, (jsize)primeira, (const jbyte *)(session->haptics_ring + inicio));
+	if(n > primeira)
+		E->SetByteArrayRegion(env, out, (jsize)primeira, (jsize)(n - primeira), (const jbyte *)session->haptics_ring);
+
+	atomic_store_explicit(&session->haptics_ring_r, r + n, memory_order_release);
+	return (jint)n;
+}
