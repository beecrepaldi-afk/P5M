+/**
+ * P5M: lei mu, para caber a trilha de haptica em oito bits.
+ *
+ * Devolve o valor ja em [-1, 1]. Cresce depressa perto de zero e devagar perto
+ * do teto: e a mesma forma que a telefonia digital usa para caber voz em oito
+ * bits, e vale aqui pela mesma razao -- a diferenca entre nada e pouco importa
+ * muito mais do que a diferenca entre muito e muitissimo.
+ *
+ * Acima da referencia satura. Nao e corte: a curva ja chega la achatada, e o
+ * que passa disso e um impacto que ja estava no maximo do que a bobina faz.
+ */
+static float p5m_mu(float amostra)
+{
+	float modulo = amostra < 0.0f ? -amostra : amostra;
+	modulo /= P5M_HAPTICS_REFERENCIA;
+	if(modulo > 1.0f)
+		modulo = 1.0f;
+	float comprimido = log1pf(P5M_HAPTICS_MU * modulo) / log1pf(P5M_HAPTICS_MU);
+	return amostra < 0.0f ? -comprimido : comprimido;
+}
