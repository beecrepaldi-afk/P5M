+	// P5M: quanto audio espera no buffer, e o corte do que sobra.
+	//
+	// O buffer comporta ~170 ms. Quando o Wi-Fi engasga, a saida toca
+	// silencio; depois o atrasado chega de uma vez e fica guardado. Como o
+	// console manda no mesmo ritmo em que o Quest toca, esse atraso nunca
+	// mais saia -- o som ficava atras da imagem ate o fim da sessao. O que se
+	// mede e o *minimo* que sobra depois de cada leitura, numa janela de meio
+	// segundo: o que nunca foi preciso nesse tempo e atraso parado, e nao
+	// folga contra o jitter. Passando do teto, o excesso e descartado de uma
+	// vez, ate o alvo.
+	std::atomic<uint64_t> p5m_pushed{0};
+	std::atomic<uint64_t> p5m_popped{0};
+	uint64_t p5m_residual_min = UINT64_MAX; // so no callback
+	uint64_t p5m_residual_window_ns = 0;    // so no callback
+	std::atomic<uint32_t> p5m_level_min_us{UINT32_MAX};
+	std::atomic<uint32_t> p5m_level_max_us{0};
+	std::atomic<uint32_t> p5m_trimmed_ms{0};
+	std::atomic<uint32_t> p5m_underruns{0};
+
 	AudioOutput() : stream_callback(this) {}
 };
 
