+// P5M: alvo e teto do atraso parado, em milissegundos. O teto deixa passar o
+// jitter comum do Wi-Fi sem cortar nada; o alvo guarda uma folga de um pacote
+// e meio de audio (10 ms cada) contra o proximo engasgo.
+#define P5M_AUDIO_STANDING_MAX_MS 40
+#define P5M_AUDIO_STANDING_TARGET_MS 15
+#define P5M_AUDIO_WINDOW_NS 500000000ULL
+
+static void p5m_trim_audio(AudioOutput *ao, oboe::AudioStream *stream, size_t delivered)
+{
+	const uint64_t popped = ao->p5m_popped.fetch_add(delivered, std::memory_order_relaxed) + delivered;
+	const uint64_t pushed = ao->p5m_pushed.load(std::memory_order_relaxed);
+	const uint64_t residual = pushed > popped ? pushed - popped : 0;
+	const uint64_t bytes_por_ms = (uint64_t)stream->getBytesPerFrame() * stream->getSampleRate() / 1000;
+	if(bytes_por_ms == 0)
+		return;
+
+	const uint32_t nivel_us = (uint32_t)(residual * 1000 / bytes_por_ms);
+	if(nivel_us < ao->p5m_level_min_us.load(std::memory_order_relaxed))
+		ao->p5m_level_min_us.store(nivel_us, std::memory_order_relaxed);
+	if(nivel_us > ao->p5m_level_max_us.load(std::memory_order_relaxed))
+		ao->p5m_level_max_us.store(nivel_us, std::memory_order_relaxed);
+
+	if(residual < ao->p5m_residual_min)
+		ao->p5m_residual_min = residual;
+	const uint64_t agora = p5m_now_ns();
+	if(ao->p5m_residual_window_ns == 0)
+		ao->p5m_residual_window_ns = agora;
+	if(agora - ao->p5m_residual_window_ns < P5M_AUDIO_WINDOW_NS)
+		return;
+
+	const uint64_t parado = ao->p5m_residual_min;
+	ao->p5m_residual_min = UINT64_MAX;
+	ao->p5m_residual_window_ns = agora;
+	if(parado == UINT64_MAX || parado <= P5M_AUDIO_STANDING_MAX_MS * bytes_por_ms)
+		return;
+
+	// Descarta em quadros inteiros, para nao trocar os canais de lugar.
+	const size_t quadro = (size_t)stream->getBytesPerFrame();
+	size_t sobra = (size_t)(parado - P5M_AUDIO_STANDING_TARGET_MS * bytes_por_ms);
+	sobra -= sobra % quadro;
+	uint8_t lixo[1024];
+	size_t descartado = 0;
+	while(descartado < sobra)
+	{
+		size_t pedaco = sobra - descartado < sizeof(lixo) ? sobra - descartado : sizeof(lixo);
+		size_t saiu = ao->buf.Pop(lixo, pedaco);
+		descartado += saiu;
+		if(saiu < pedaco)
+			break;
+	}
+	ao->p5m_popped.fetch_add(descartado, std::memory_order_relaxed);
+	ao->p5m_trimmed_ms.fetch_add((uint32_t)(descartado / bytes_por_ms), std::memory_order_relaxed);
+}
