+	const uint8_t *const *candidates, const size_t *candidate_lens, size_t candidate_count,
+	const uint8_t *const *roots, const size_t *root_lens, size_t root_count,
+	char **pem_out, size_t *pem_len_out, ChiakiLog *log);
+
