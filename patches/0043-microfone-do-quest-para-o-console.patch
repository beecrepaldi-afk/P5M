+/*
+ * P5M: microfone.
+ *
+ * O formato e o do cliente de desktop do chiaki: estereo, 48 kHz, blocos de
+ * 480 amostras (10 ms). O remetente da lib so aceita pacotes de exatamente 40
+ * bytes e descarta o resto como violacao de protocolo; 40 bytes a cada 10 ms
+ * sao 32 kbps, entao o Opus vai em taxa fixa nesse valor -- em taxa variavel,
+ * todo pacote menor (silencio, fala baixa) sumiria. O ctl vai pelo prototipo
+ * publico da libopus, que esta ligada nesta mesma biblioteca; o include dela e
+ * privado da lib.
+ */
+extern int opus_encoder_ctl(struct OpusEncoder *st, int request, ...);
+#define P5M_OPUS_SET_BITRATE_REQUEST 4002
+#define P5M_OPUS_SET_VBR_REQUEST 4006
+#define P5M_MIC_FRAME_SAMPLES 480
+#define P5M_MIC_CHANNELS 2
+
+JNIEXPORT jboolean JNICALL JNI_FCN(sessionMicStart)(JNIEnv *env, jobject obj, jlong ptr)
+{
+	AndroidChiakiSession *session = (AndroidChiakiSession *)ptr;
+	if(!session)
+		return JNI_FALSE;
+	if(session->mic_started)
+		return JNI_TRUE;
+	chiaki_opus_encoder_init(&session->mic_encoder, session->log);
+	ChiakiAudioHeader header;
+	chiaki_audio_header_set(&header, P5M_MIC_CHANNELS, 16, 48000, P5M_MIC_FRAME_SAMPLES);
+	chiaki_opus_encoder_header(&header, &session->mic_encoder, &session->session);
+	if(!session->mic_encoder.opus_encoder)
+	{
+		chiaki_opus_encoder_fini(&session->mic_encoder);
+		__android_log_print(ANDROID_LOG_WARN, "P5MVR", "Microphone: the Opus encoder did not start");
+		return JNI_FALSE;
+	}
+	opus_encoder_ctl(session->mic_encoder.opus_encoder, P5M_OPUS_SET_VBR_REQUEST, 0);
+	opus_encoder_ctl(session->mic_encoder.opus_encoder, P5M_OPUS_SET_BITRATE_REQUEST, 32000);
+	session->mic_started = true;
+	ChiakiErrorCode err = chiaki_session_connect_microphone(&session->session);
+	if(err == CHIAKI_ERR_SUCCESS)
+		err = chiaki_session_toggle_microphone(&session->session, false);
+	__android_log_print(ANDROID_LOG_INFO, "P5MVR", "Microphone: connected to the console (%s)",
+			chiaki_error_string(err));
+	return err == CHIAKI_ERR_SUCCESS ? JNI_TRUE : JNI_FALSE;
+}
+
+JNIEXPORT void JNICALL JNI_FCN(sessionMicFrame)(JNIEnv *env, jobject obj, jlong ptr, jshortArray pcm)
+{
+	AndroidChiakiSession *session = (AndroidChiakiSession *)ptr;
+	if(!session || !session->mic_started)
+		return;
+	if(E->GetArrayLength(env, pcm) != P5M_MIC_FRAME_SAMPLES * P5M_MIC_CHANNELS)
+		return;
+	int16_t buf[P5M_MIC_FRAME_SAMPLES * P5M_MIC_CHANNELS];
+	E->GetShortArrayRegion(env, pcm, 0, P5M_MIC_FRAME_SAMPLES * P5M_MIC_CHANNELS, buf);
+	chiaki_opus_encoder_frame(buf, &session->mic_encoder);
+}
+
+JNIEXPORT void JNICALL JNI_FCN(sessionMicMute)(JNIEnv *env, jobject obj, jlong ptr, jboolean muted)
+{
+	AndroidChiakiSession *session = (AndroidChiakiSession *)ptr;
+	if(!session || !session->mic_started)
+		return;
+	chiaki_session_toggle_microphone(&session->session, muted == JNI_TRUE);
+}
