+	// e o mesmo desenho do kill_decoder do video.
+	ssize_t codec_buf_index = AMediaCodec_dequeueInputBuffer(decoder->codec, 100 * 1000);
 	if(codec_buf_index >= 0)
 	{
 		CHIAKI_LOGI(decoder->log, "Audio Decoder sending EOS buffer");
@@ -40,10 +88,35 @@ void android_chiaki_audio_decoder_shutdown_codec(AndroidChiakiAudioDecoder *deco
 	}
 	else
 		CHIAKI_LOGE(decoder->log, "Failed to get input buffer for shutting down Audio Decoder!");
+	__android_log_print(ANDROID_LOG_INFO, "P5MVR", "Audio decoder release: stopping the codec");
+	AMediaCodec_stop(decoder->codec);
 	chiaki_mutex_unlock(&decoder->codec_mutex);
-	chiaki_thread_join(&decoder->output_thread, NULL);
+
+	// P5M: espera com prazo pela thread de saida. Ela confere `parar` a cada
+	// OUTPUT_BUFFER_TIMEOUT_MS, entao 1 s so esgota se ela estiver presa
+	// dentro do proprio codec ou do callback de audio. Nesse caso ela e
+	// abandonada e passa a ser dona do codec (ver P5MSaidaAudio): apaga-lo
+	// daqui com ela ainda dentro dele derrubaria o processo.
+	__android_log_print(ANDROID_LOG_INFO, "P5MVR", "Audio decoder release: waiting for the output thread");
+	if(saida && chiaki_thread_timedjoin(&decoder->output_thread, NULL, 1000) != CHIAKI_ERR_SUCCESS)
+	{
+		int esperado = P5M_SAIDA_RODANDO;
