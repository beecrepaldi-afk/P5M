+			decoder->p5m_saida = NULL;
+			return;
+		}
+		// Terminou entre o prazo e a troca: agora o join volta na hora.
+		chiaki_thread_join(&decoder->output_thread, NULL);
+	}
+	__android_log_print(ANDROID_LOG_INFO, "P5MVR", "Audio decoder release: deleting the codec");
 	AMediaCodec_delete(decoder->codec);
 	decoder->codec = NULL;
+	free(saida);
+	decoder->p5m_saida = NULL;
