 #define INPUT_BUFFER_TIMEOUT_MS 10
 
+// P5M: a thread de saida espera por no maximo isto de cada vez, e entre uma
+// espera e outra confere se o encerramento pediu para ela sair.
+#define OUTPUT_BUFFER_TIMEOUT_MS 100
+
+// P5M: o que a thread de saida divide com o encerramento (dev.231).
+//
+// Ate a dev.227 a thread esperava o codec sem prazo (-1) e lia
+// decoder->codec a cada volta. Quando o decodificador para de produzir --
+// "Failed to get input audio buffer" pouco antes do fim, uma em tres
+// sessoes na dev.226 -- a espera nunca voltava, e a checagem de
+// encerramento no laco nunca rodava. Pior: no caminho de prazo esgotado o
+// encerramento zerava decoder->codec com a thread viva, que ao acordar
+// chamaria o codec por um ponteiro nulo.
+//
+// Agora a thread tem a propria copia do codec, espera no maximo
+// OUTPUT_BUFFER_TIMEOUT_MS de cada vez e sai assim que `parar` sobe. Se
+// ainda assim nao sair a tempo, o encerramento a ABANDONA com uma troca
+// atomica de `estado`, e a partir dai ela e dona do codec e desta
+// estrutura: quando finalmente sair, apaga os dois. Quem ganhar a troca
+// limpa; o outro nao toca em nada.
+enum { P5M_SAIDA_RODANDO, P5M_SAIDA_TERMINOU, P5M_SAIDA_ABANDONADA };
+
+typedef struct p5m_saida_audio_t
+{
+	struct AMediaCodec *codec;
+	AndroidChiakiAudioDecoder *decoder;
+	atomic_bool parar;
+	atomic_int estado;
+} P5MSaidaAudio;
