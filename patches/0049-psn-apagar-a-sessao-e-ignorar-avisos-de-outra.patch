+// P5M: a notificacao traz o id de uma sessao que nao e a nossa? Sem id no
+// corpo, fica valendo como nossa, que e o que o codigo original assumia.
+static bool notificacao_de_outra_sessao(Session *session, Notification *notif)
+{
+    json_object *body_json = NULL, *data_json = NULL, *sid_json = NULL;
+    if(!notif->json
+        || !json_object_object_get_ex(notif->json, "body", &body_json)
+        || !json_object_object_get_ex(body_json, "data", &data_json)
+        || !json_object_object_get_ex(data_json, "sessionId", &sid_json)
+        || !json_object_is_type(sid_json, json_type_string))
+        return false;
+    return strcmp(json_object_get_string(sid_json), session->session_id) != 0;
+}
