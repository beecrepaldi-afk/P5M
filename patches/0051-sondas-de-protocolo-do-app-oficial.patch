+/*
+ * P5M: cabecalhos que o app oficial (9.5.0) manda ao PS5 e o chiaki nao.
+ *
+ * RP-PadProcNo e sempre 3 no oficial; RP-ReqMoreInfo e 1 (0x1001 so no modo
+ * GCM, que nao usamos). Em troca o console responderia com a qualidade do
+ * Wi-Fi dele (RP-Rssi-Dbm/Percent), o tipo do aparelho (RP-Device), o botao
+ * de confirmar (RP-Enterkey) e um RP-Vmode de sentido ainda desconhecido.
+ * Desligado por padrao: e uma sonda, ligada no Diagnostico.
+ */
+static bool p5m_ctrl_mais_info(ChiakiSession *session)
+{
+	return chiaki_target_is_ps5(session->target) && p5m_sonda("p5m_probe_ctrl_more_info") > 0;
+}
+
+static void p5m_guardar_extra(CtrlResponse *response, const char *chave, const char *valor)
+{
+	size_t usado = strlen(response->p5m_extras);
+	if(usado + 4 >= sizeof(response->p5m_extras))
+		return;
+	snprintf(response->p5m_extras + usado, sizeof(response->p5m_extras) - usado,
+			"%s%s=%s", usado ? ", " : "", chave, valor);
+}
