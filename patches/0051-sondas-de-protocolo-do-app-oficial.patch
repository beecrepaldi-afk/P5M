diff --git a/lib/src/p5m_sonda.h b/lib/src/p5m_sonda.h
new file mode 100644
--- /dev/null
+++ b/lib/src/p5m_sonda.h
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#ifndef P5M_SONDA_H
+#define P5M_SONDA_H
+
+/*
+ * P5M: sondas de protocolo escolhidas no Diagnostico (dev.242).
+ *
+ * Quem guarda a escolha e a libp5m-vr.so, que nao e ligada a libchiaki -- o
+ * chiaki nao conhece o projeto de fora (mesmo arranjo do gancho de audio do
+ * patch 0005). O simbolo e procurado em tempo de execucao; sem ele, ou fora
+ * do Android, a sonda vale 0 e o protocolo segue exatamente como o do chiaki.
+ */
+#ifdef __ANDROID__
+#include <dlfcn.h>
+
+static inline int p5m_sonda(const char *nome)
+{
+	void *lib = dlopen("libp5m-vr.so", RTLD_NOW | RTLD_NOLOAD);
+	if(!lib)
+		return 0;
+	int (*fn)(void) = (int (*)(void))dlsym(lib, nome);
+	int valor = fn ? fn() : 0;
+	dlclose(lib);
+	return valor;
+}
+#else
+static inline int p5m_sonda(const char *nome) { (void)nome; return 0; }
+#endif
+
+#endif // P5M_SONDA_H
