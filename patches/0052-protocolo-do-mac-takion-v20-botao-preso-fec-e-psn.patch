+		double db = rms > 1e-9 ? 20.0 * log10(rms) : -180.0;
+		double lf = decoder->ch_sum_sq[c] > 0.0 ? 100.0 * decoder->ch_lf_sum_sq[c] / decoder->ch_sum_sq[c] : 0.0;
