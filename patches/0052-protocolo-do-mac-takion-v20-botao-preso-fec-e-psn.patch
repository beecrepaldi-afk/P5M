+// P5M: lê o tamanho de um quadro Opus (RFC 6716, 3.2.1).
+static bool p5m_opus_frame_len(const uint8_t **p, const uint8_t *end, size_t *len)
+{
+	if(*p >= end)
+		return false;
+	if(**p < 252)
+	{
+		*len = **p;
+		*p += 1;
+		return true;
+	}
+	if(*p + 1 >= end)
+		return false;
+	*len = (size_t)(*p)[0] + 4 * (size_t)(*p)[1];
+	*p += 2;
+	return true;
