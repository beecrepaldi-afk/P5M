 			break;
 		case CTRL_MESSAGE_TYPE_HEARTBEAT_REQ:
 			ctrl_message_received_heartbeat_req(ctrl, payload, payload_size);
@@ -1078,6 +1082,19 @@ static void ctrl_message_received_login(ChiakiCtrl *ctrl, uint8_t *payload, size
 		case CTRL_LOGIN_STATE_SUCCESS:
 			CHIAKI_LOGI(ctrl->session->log, "Ctrl received Login message: success");
 			ctrl->login_pin_requested = false;
+			// P5M (patch 0054): na LAN o PS5 responde "InvalidSessionId" sempre
+			// 2,0 s depois do login (medido em 18/11/2026: 1,910, 1,995 e
+			// 1,996 s), e o chiaki so liga os recursos (DualSense, microfone,
+			// telas) e segue com o id reserva depois disso. Aqui os dois
+			// acontecem ja no login. Pela PSN o id do console vale e a espera
+			// continua.
+			if(!ctrl->session->holepunch_session && !ctrl->p5m_features_sent)
+			{
+				CHIAKI_LOGW(ctrl->session->log, "P5M: fast start, features and fallback session id right after login");
+				ctrl->p5m_features_sent = true;
+				ctrl_enable_features(ctrl);
+				ctrl_message_set_fallback_session_id(ctrl);
+			}
 			break;
 		case CTRL_LOGIN_STATE_PIN_INCORRECT:
 			CHIAKI_LOGI(ctrl->session->log, "Ctrl received Login message: PIN incorrect");
