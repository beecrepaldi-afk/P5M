@@ -153,6 +153,7 @@ CHIAKI_EXPORT ChiakiErrorCode chiaki_ctrl_init(ChiakiCtrl *ctrl, ChiakiSession *
 	ctrl->should_stop = false;
 	ctrl->login_pin_entered = false;
 	ctrl->login_pin_requested = false;
