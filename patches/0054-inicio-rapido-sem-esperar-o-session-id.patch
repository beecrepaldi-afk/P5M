 	ctrl->cant_displaya = false;
@@ -863,7 +864,10 @@ static void ctrl_message_received(ChiakiCtrl *ctrl, uint16_t msg_type, uint8_t *
 	{
 		case CTRL_MESSAGE_TYPE_SESSION_ID:
 			ctrl_message_received_session_id(ctrl, payload, payload_size);
-			ctrl_enable_features(ctrl);
+			// P5M: no caminho rapido (patch 0054) os recursos ja foram ligados
+			// no login; liga-los de novo duplicaria as mensagens.
+			if(!ctrl->p5m_features_sent)
